<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Trilium</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- TrollStore 一键安装入口：用系统「放大器」的 scheme 做安装协议（规避越狱检测）。
	     iOS 9+ 起 canOpenURL 必须先在此声明白名单，否则恒为 false。 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>apple-magnifier</string>
	</array>
	<!-- 分享扩展经此 scheme 把内容带回宿主（trilium://quick-note?text=...） -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hhxxc.trilium.quicknote</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trilium</string>
			</array>
		</dict>
	</array>
	<!-- 阅读页长按图片 → 保存到相册（仅写入相册，不读取） -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于将笔记中的图片保存到相册</string>
	<!-- ⚠️ 应用锁需要这份声明，否则 iOS **不会弹 Face ID**（认证静默失败，
	     表现为「启用了密码锁但没反应、点解锁也解不开」）。缺它是最常见的坑。 -->
	<key>NSFaceIDUsageDescription</key>
	<string>用于解锁 Trilium，保护你的笔记不被他人查看</string>
	<!-- Trilium 服务端可能是 http（内网），允许任意明文加载 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
